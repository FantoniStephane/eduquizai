UTILISATEUR: id_utilisateur [INTEGER], nom [VARCHAR(50)], prenom [VARCHAR(50)], email [VARCHAR(100)], mot_de_passe [VARCHAR(255)], role [VARCHAR(20)], est_actif [BOOLEAN], date_creation [DATETIME]
POSSEDE, 0N UTILISATEUR, 11 LECON
LECON: id_lecon [INTEGER], titre [VARCHAR(100)], matiere [VARCHAR(50)], niveau_scolaire [VARCHAR(20)], contenu [TEXT], date_creation [DATETIME], date_modification [DATETIME]

