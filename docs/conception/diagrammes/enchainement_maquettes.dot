digraph G {
  graph [rankdir=TB, bgcolor="#F8FAFC", pad=0.4, nodesep=0.25, ranksep=0.5, fontname="Inter", label=<<B>Enchaînement des maquettes — EduQuizAI</B>>, labelloc=t, fontsize=24];
  node [shape=plain, fontname="Inter"];
