  n01 [label=<<TABLE BORDER="1" COLOR="#1E3A8A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/01.png"/></TD></TR><TR><TD BGCOLOR="#1E3A8A"><FONT POINT-SIZE="19" COLOR="white"><B>1 · Connexion</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">page d'entrée</FONT></TD></TR></TABLE>>];
