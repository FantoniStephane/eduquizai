  n08 -> n11 [label="Exporter"];
  n03 -> n10 [label="Supprimer", color="#B91C1C", fontcolor="#B91C1C"];
  n08 -> n10 [label="Supprimer", color="#B91C1C", fontcolor="#B91C1C"];
  n02 -> n01 [label="Déconnexion", style=dotted, constraint=false];
