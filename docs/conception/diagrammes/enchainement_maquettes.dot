  n09 [label=<<TABLE BORDER="1" COLOR="#B45309" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/09.png"/></TD></TR><TR><TD BGCOLOR="#B45309"><FONT POINT-SIZE="19" COLOR="white"><B>9 · Modification quiz</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">Update</FONT></TD></TR></TABLE>>];
  n10 [label=<<TABLE BORDER="1" COLOR="#B91C1C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/10.png"/></TD></TR><TR><TD BGCOLOR="#B91C1C"><FONT POINT-SIZE="19" COLOR="white"><B>10 · Suppression</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">Delete (leçon ou quiz)</FONT></TD></TR></TABLE>>];
  n11 [label=<<TABLE BORDER="1" COLOR="#1E3A8A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/11.png"/></TD></TR><TR><TD BGCOLOR="#1E3A8A"><FONT POINT-SIZE="19" COLOR="white"><B>11 · Export</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">PDF élève (maquette : PDF · CSV · JSON)</FONT></TD></TR></TABLE>>];
