  n03 [label=<<TABLE BORDER="1" COLOR="#1D4ED8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/03.png"/></TD></TR><TR><TD BGCOLOR="#1D4ED8"><FONT POINT-SIZE="19" COLOR="white"><B>3 · Liste des leçons</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">Read</FONT></TD></TR></TABLE>>];
  n04 [label=<<TABLE BORDER="1" COLOR="#B45309" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/04.png"/></TD></TR><TR><TD BGCOLOR="#B45309"><FONT POINT-SIZE="19" COLOR="white"><B>4 · Formulaire leçon</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">Create / Update</FONT></TD></TR></TABLE>>];
  n04c [label=<<TABLE BORDER="1" COLOR="#B45309" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/04c.png"/></TD></TR><TR><TD BGCOLOR="#B45309"><FONT POINT-SIZE="19" COLOR="white"><B>4c · Import fichier</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">remplit le contenu</FONT></TD></TR></TABLE>>];
  n05 [label=<<TABLE BORDER="1" COLOR="#1D4ED8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/05.png"/></TD></TR><TR><TD BGCOLOR="#1D4ED8"><FONT POINT-SIZE="19" COLOR="white"><B>5 · Détail leçon</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">Read</FONT></TD></TR></TABLE>>];
  n06 [label=<<TABLE BORDER="1" COLOR="#1D4ED8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/06.png"/></TD></TR><TR><TD BGCOLOR="#1D4ED8"><FONT POINT-SIZE="19" COLOR="white"><B>6 · Liste des quiz</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">Read</FONT></TD></TR></TABLE>>];
  n07 [label=<<TABLE BORDER="1" COLOR="#15803D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="113"><IMG SCALE="TRUE" SRC="miniatures/07.png"/></TD></TR><TR><TD BGCOLOR="#15803D"><FONT POINT-SIZE="19" COLOR="white"><B>7 · Générateur</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="15" COLOR="#475569">Create (IA)</FONT></TD></TR></TABLE>>];
