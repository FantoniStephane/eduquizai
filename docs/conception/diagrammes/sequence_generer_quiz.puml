@startuml sequence_generer_quiz
skinparam shadowing false
hide footbox
skinparam ArrowColor #1F4E79
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantBackgroundColor #EAF1FB
skinparam ParticipantBorderColor #1F4E79
skinparam DatabaseBackgroundColor #EAF1FB
skinparam DatabaseBorderColor #1F4E79
skinparam ActorBorderColor #1F4E79
skinparam SequenceLifeLineBorderColor #1F4E79
skinparam SequenceGroupBorderColor #1F4E79
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B45309
title Diagramme de séquence — Générer un quiz

autonumber
actor "Enseignant" as ENS
participant "Navigateur" as NAV
participant "Application Django\n(conteneur web)" as WEB
database "PostgreSQL" as PG
participant "Microservice IA\n(conteneur ia)" as IA
participant "Ollama\n(modèle local)" as OLL
database "MongoDB" as MDB

ENS -> NAV : Choisit la leçon, la difficulté,\nles types et le nombre de questions,\npuis clique sur « Générer »
NAV -> NAV : Affiche l'indicateur de chargement (écran 7b)
NAV -> WEB : POST /quiz/generer/ (formulaire + jeton CSRF)
activate WEB
WEB -> WEB : Vérifie la session, le jeton CSRF\net les paramètres du formulaire
WEB -> PG : Lit la leçon (id, propriétaire = utilisateur connecté)
activate PG
PG --> WEB : Leçon (contenu en Markdown)
deactivate PG

alt Leçon inexistante ou d'un autre enseignant
  WEB --> NAV : 404 Page introuvable
else Leçon trouvée
  WEB -> WEB : Signe un jeton JWT de 2 minutes\n(secret partagé avec le service IA)
  WEB -> IA : POST /api/generer-quiz/\nAuthorization: Bearer <JWT>\n(contenu de la leçon + paramètres, délai maximum)
  activate IA
  IA -> IA : Vérifie le jeton JWT (signature, durée,\németteur, destinataire) et les paramètres
  IA -> IA : Construit le prompt\n(consignes + contenu de la leçon délimité)
  IA -> OLL : Demande de génération au format JSON
  activate OLL
  OLL --> IA : Réponse du modèle (JSON)
  deactivate OLL
  IA -> IA : Vérifie la structure du JSON\n(nombre et types de questions, choix,\nbonne réponse, explication)

  alt Réponse valide
    IA --> WEB : 200 OK — questions du quiz
    deactivate IA
    WEB -> WEB : Contrôle le document avant écriture
    WEB -> MDB : Enregistre le quiz\n(statut « brouillon », propriétaire, leçon, date)
    activate MDB
    MDB --> WEB : Identifiant du quiz
    deactivate MDB
    WEB --> NAV : 302 Redirection vers le détail du quiz\n+ message « Quiz généré : relisez-le avant de le valider »
    NAV -> WEB : GET /quiz/<id>/
    WEB -> MDB : Lit le quiz (id, propriétaire = utilisateur connecté)
    MDB --> WEB : Quiz
    WEB --> NAV : Page « Détail du quiz » (écran 8)
    NAV --> ENS : Affiche le quiz en brouillon
  else Délai dépassé, IA indisponible ou JSON invalide
    IA --> WEB : Erreur (400, 401, 502, 503 ou 504)
    WEB --> NAV : Formulaire réaffiché avec un message d'erreur\n(aucun quiz enregistré)
    NAV --> ENS : Propose de relancer la génération
  end
end
deactivate WEB

note over ENS, MDB
  Appel synchrone : la page attend la réponse de l'IA derrière l'indicateur de chargement.
  Objectif du cahier des charges : moins de 5 secondes pour un quiz simple.
end note
@enduml
