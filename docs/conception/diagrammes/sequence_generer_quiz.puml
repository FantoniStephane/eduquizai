@startuml sequence_generer_quiz
skinparam shadowing false
hide footbox
skinparam dpi 100
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam ArrowColor #1F4E79
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 6
skinparam ParticipantBackgroundColor #EAF1FB
skinparam ParticipantBorderColor #1F4E79
skinparam DatabaseBackgroundColor #EAF1FB
skinparam DatabaseBorderColor #1F4E79
skinparam ActorBorderColor #1F4E79
skinparam ActorBackgroundColor #FFFFFF
skinparam SequenceLifeLineBorderColor #1F4E79
skinparam SequenceGroupBorderColor #1F4E79
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B45309
title Diagramme de séquence — Générer un quiz

autonumber
actor "Enseignant\n(navigateur)" as ENS
participant "Application\nDjango" as WEB
database "PostgreSQL" as PG
database "MongoDB" as MDB
participant "Microservice\nIA" as IA
participant "Fournisseur\nd'IA" as OLL

ENS -> WEB : POST /quiz/generer/\n(leçon, réglages,\nCSRF)
activate WEB
note left of WEB : Écran 7b :\nattente, bouton\nAnnuler
WEB -> WEB : Vérifie session,\nCSRF et réglages
WEB -> PG : Lit la leçon\nde l'enseignant
PG --> WEB : Leçon (Markdown)

alt Leçon d'un autre enseignant
  WEB --> ENS : Formulaire :\n« Cette leçon n'existe pas. »
else Leçon trouvée
  WEB -> WEB : Signe un jeton JWT (2 min)
  WEB -> IA : POST /api/generer-quiz/\n+ jeton JWT + leçon
  activate IA
  IA -> IA : Vérifie le jeton\net les réglages
  IA -> IA : Construit le prompt
  IA -> OLL : Demande un quiz\nen JSON
  OLL --> IA : Réponse JSON
  IA -> IA : Vérifie le JSON\n(un nouvel essai\nsi invalide)

  alt Quiz valide
    IA --> WEB : 200 — questions
    deactivate IA
    WEB -> WEB : Vérifie l'annulation,\ncontrôle le quiz
    WEB -> MDB : Enregistre le quiz\n(brouillon, propriétaire,\nleçon)
    MDB --> WEB : Identifiant
    WEB --> ENS : 302 vers la liste\ndes quiz + message
    ENS -> WEB : GET /quiz/
    WEB -> MDB : Lit les quiz\nde l'enseignant
    MDB --> WEB : Quiz
    WEB --> ENS : Liste des quiz (écran 6) :\nnouveau brouillon
  else Échec
    WEB --> ENS : Formulaire + erreur\n(IA, annulation ou\nMongoDB : aucun quiz\nenregistré)
  end
end
deactivate WEB

note over ENS, OLL
  Appel synchrone : la page attend l'IA.
  Objectif du CDC : moins de 5 s.
end note
@enduml
