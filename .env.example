# PostgreSQL
POSTGRES_DB=eduquizai
POSTGRES_USER=eduquizai
POSTGRES_PASSWORD=a_changer

# MongoDB
# Compte root : administration du serveur uniquement (jamais utilisé par l'application)
MONGO_INITDB_ROOT_USERNAME=eduquizai
MONGO_INITDB_ROOT_PASSWORD=a_changer
MONGO_DB=eduquizai
# Compte de l'application : droits limités à la base MONGO_DB
MONGO_APP_USER=eduquizai_app
MONGO_APP_PASSWORD=a_changer
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# Microservice IA
IA_SECRET_KEY=a_changer
IA_DEBUG=True
# Secret partagé entre web et ia pour signer les jetons JWT (32 caractères minimum)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
IA_JWT_SECRET=a_changer_par_une_longue_valeur_aleatoire
OLLAMA_MODELE=llama3.2:3b
OLLAMA_DELAI=60
# Fournisseur d'IA : mistral (API externe, par défaut) ou ollama (local)
IA_FOURNISSEUR=mistral
# Attente maximale d'une génération côté web (secondes), > OLLAMA_DELAI
IA_DELAI=130
# Clé personnelle créée sur console.mistral.ai (secret : jamais dans Git)
MISTRAL_API_KEY=
MISTRAL_MODELE=ministral-3b-2512

# Django
DJANGO_SECRET_KEY=a_changer
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production uniquement (serveur) : HTTPS, cache partagé, IP réelle derrière Traefik
DJANGO_PRODUCTION=False
# Production : adresse publique du site (ex. https://eduquizai.duckdns.org)
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# E-mails (développement : affichés dans les logs du conteneur web)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
